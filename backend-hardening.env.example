# ==============================================================================
# CẤU HÌNH BỔ SUNG / CỦNG CỐ BẢO MẬT BACKEND — QuanNguyenS
# Lưu ý: KHÔNG chỉnh sửa file `.env.example` (file được khóa tại PROTECTED-DATA.md).
# Sao chép các biến dưới đây vào `.env` hoặc Render Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KHÓA BÍ MẬT TÁCH BIỆT (FAIL-CLOSED TRONG PRODUCTION)
# Mỗi khóa phải dài tối thiểu 32 ký tự (64 hex chars = openssl rand -hex 32)
# TUYỆT ĐỐI KHÔNG dùng chung 1 giá trị cho nhiều khóa!
# ------------------------------------------------------------------------------
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ORDER_TOKEN_SECRET=
CUSTOMER_AUTH_SECRET=
JWT_SECRET=

# ------------------------------------------------------------------------------
# 2. EMAIL GIAO DỊCH (RESEND HOẶC GMAIL SMTP)
# ------------------------------------------------------------------------------
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# GMAIL_APP_PASSWORD=

# ------------------------------------------------------------------------------
# 3. CHẨN ĐOÁN / BẢO TRÌ / SAO LƯU
# ------------------------------------------------------------------------------
# Khóa chẩn đoán nội bộ (tối thiểu 16 ký tự; để trống nếu không cần xem stack trace)
DIAGNOSTIC_KEY=

# Thư mục lưu snapshot backup (mặc định: server/data/backups; nên trỏ tới Persistent Disk)
# BACKUP_DIR=/var/data/quannguyens/backups

# Tắt seed đánh giá mẫu tự động (production mặc định ĐÃ TẮT trừ khi đặt REVIEW_SEED_ENABLED=true)
# REVIEW_SEED_ENABLED=false

# Tắt yêu cầu Google Sheets bắt buộc (mặc định degraded-safe khi chưa cấu hình)
# REQUIRE_GOOGLE_SHEETS=false

# ------------------------------------------------------------------------------
# 4. SUPABASE CLOUD & BẢO MẬT WEBHOOK
# ------------------------------------------------------------------------------
# LUÔN dùng SUPABASE_SERVICE_ROLE_KEY ở backend; KHÔNG dùng anon key cho ghi dữ liệu.
# Nhớ chạy scripts/supabase-schema.sql mới nhất để khóa RLS & REVOKE anon access!
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

SEPAY_WEBHOOK_API_KEY=
PAYMENT_WEBHOOK_SECRET=
VIETTELPOST_WEBHOOK_SECRET=

