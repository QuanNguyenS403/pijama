# ==============================================================================
# CẤU HÌNH BỔ SUNG / CỦNG CỐ BẢO MẬT BACKEND — QuanNguyenS
# Lưu ý: KHÔNG chỉnh sửa file `.env.example` (file được khóa tại PROTECTED-DATA.md).
# Sao chép các biến dưới đây vào `.env` hoặc Render Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KHÓA BÍ MẬT TÁCH BIỆT (FAIL-CLOSED TRONG PRODUCTION)
# Mỗi khóa phải dài tối thiểu 32 ký tự (64 hex chars = openssl rand -hex 32)
# TUYỆT ĐỐI KHÔNG dùng chung 1 giá trị cho nhiều khóa!
# ------------------------------------------------------------------------------
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ORDER_TOKEN_SECRET=
CUSTOMER_AUTH_SECRET=
JWT_SECRET=

# ------------------------------------------------------------------------------
# 2. EMAIL GIAO DỊCH (HTTPS PORT 443 CHO RENDER FREE / SMTP CHO VPS & GÓI TRẢ PHÍ)
# Lưu ý: Render gói Free chặn cổng SMTP 25/465/587 từ 26/09/2025.
# Trên Render Free bắt buộc dùng GAS_EMAIL_WEBHOOK_URL hoặc RESEND_API_KEY.
# ------------------------------------------------------------------------------
GAS_EMAIL_WEBHOOK_URL=
GAS_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_ALLOW_SMTP_ON_RENDER=false

# ------------------------------------------------------------------------------
# 3. Ổ ĐĨA BỀN VỮNG (PERSISTENT DISK) & SAO LƯU DỮ LIỆU (G3)
# Trên Render gói Starter+ hoặc VPS, gắn Persistent Disk vào /var/data/qns
# ------------------------------------------------------------------------------
# DATA_DIR=/var/data/qns/data
# UPLOADS_DIR=/var/data/qns/uploads/payment-proofs
# BACKUP_DIR=/var/data/qns/backups
# PERSISTENT_STORAGE_CONFIRMED=true

# ------------------------------------------------------------------------------
# 4. QUẢN LÝ TỒN KHO ĐƠN VIETQR BỎ DỞ & CHỐNG BOT (G6)
# ------------------------------------------------------------------------------
# Số giờ tự động hủy đơn VietQR ở trạng thái AWAITING_PAYMENT mà CHƯA tải ảnh chứng từ
# Mặc định 0 (giữ thủ công). Khuyến nghị đặt 24 (tự hủy sau 24h nếu khách không tải ảnh CK).
# Đơn đã tải ảnh chứng từ (PENDING_ADMIN_CONFIRMATION) tuyệt đối không bao giờ tự hủy.
UNPAID_QR_AUTOCANCEL_HOURS=0

# Bật xác thực Cloudflare Turnstile bắt buộc khi gửi đơn hàng (mặc định false)
TURNSTILE_ENFORCE_ORDER=false

# Chỉ bật tự động giải phóng cổng trên máy dev cá nhân (mặc định false)
DEV_AUTO_FREE_PORT=false

# ------------------------------------------------------------------------------
# 5. CHẨN ĐOÁN / BẢO TRÌ
# ------------------------------------------------------------------------------
# Khóa chẩn đoán nội bộ (tối thiểu 16 ký tự; để trống nếu không cần xem stack trace)
DIAGNOSTIC_KEY=

# Tắt seed đánh giá mẫu tự động (production mặc định ĐÃ TẮT trừ khi đặt REVIEW_SEED_ENABLED=true)
# REVIEW_SEED_ENABLED=false

# Tắt yêu cầu Google Sheets bắt buộc (mặc định degraded-safe khi chưa cấu hình)
# REQUIRE_GOOGLE_SHEETS=false

# ------------------------------------------------------------------------------
# 6. SUPABASE CLOUD & BẢO MẬT WEBHOOK
# ------------------------------------------------------------------------------
# LUÔN dùng SUPABASE_SERVICE_ROLE_KEY ở backend; KHÔNG dùng anon key cho ghi dữ liệu.
# Nhớ chạy scripts/supabase-schema.sql mới nhất để khóa RLS & REVOKE anon access!
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

SEPAY_WEBHOOK_API_KEY=
PAYMENT_WEBHOOK_SECRET=
VIETTELPOST_WEBHOOK_SECRET=
