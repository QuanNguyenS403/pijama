// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ════════════════════════════════════════════
// MODEL: USER — Tài khoản người dùng
// ════════════════════════════════════════════
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?   @unique
  fullName      String
  passwordHash  String?   // null nếu login qua OAuth
  role          UserRole  @default(CUSTOMER)
  isVerified    Boolean   @default(false)
  isActive      Boolean   @default(true)

  // Địa chỉ
  addresses     Address[]

  // Quan hệ
  orders        Order[]
  wishlist      WishlistItem[]
  reviews       Review[]
  sessions      Session[]

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  @@map("users")
}

enum UserRole {
  CUSTOMER
  ADMIN
  STAFF
}

// ════════════════════════════════════════════
// MODEL: ADDRESS — Địa chỉ giao hàng
// ════════════════════════════════════════════
model Address {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  label       String?  // "Nhà", "Văn phòng"
  fullName    String
  phone       String
  address     String
  ward        String
  district    String
  city        String
  isDefault   Boolean  @default(false)

  orders      Order[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("addresses")
}

// ════════════════════════════════════════════
// MODEL: PRODUCT — Sản phẩm
// ════════════════════════════════════════════
model Product {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  subtitle        String?
  description     String        @db.Text
  longDescription String?       @db.Text

  // Pricing
  basePrice       Int           // Đơn vị: đồng VN (không dùng float)
  comparePrice    Int?          // Giá gốc (để show giảm giá)
  costPrice       Int?          // Giá vốn (nội bộ)

  // Meta
  badge           String?       // "MỚI RA MẮT", "BÁN CHẠY"
  collection      String?       // "Thu Đông 2025"
  isActive        Boolean       @default(true)
  isArchived      Boolean       @default(false)
  isFeatured      Boolean       @default(false)
  sortOrder       Int           @default(0)

  // SEO
  metaTitle       String?
  metaDescription String?

  // Quan hệ
  variants        ProductVariant[]
  images          ProductImage[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  orderItems      OrderItem[]
  categories      CategoryProduct[]

  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("products")
}

// ════════════════════════════════════════════
// MODEL: PRODUCT VARIANT — Biến thể sản phẩm
// (Mỗi combination màu + size = 1 variant)
// ════════════════════════════════════════════
model ProductVariant {
  id              String      @id @default(cuid())
  productId       String
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Định danh biến thể
  colorName       String      // "Pink Stripe", "Navy Plaid"
  colorHex        String      // "#F2C4CE"
  colorLabel      String      // "Sọc Hồng" (Vietnamese display)
  patternType     String?     // "stripe", "plaid", "solid"
  size            String      // "S", "M", "L", "XL"

  // Pricing override (nếu variant có giá khác)
  priceOverride   Int?

  // Inventory
  stockQty        Int         @default(0)
  reservedQty     Int         @default(0)  // Đang trong đơn chưa confirm
  lowStockAlert   Int         @default(3)  // Cảnh báo khi còn ≤ 3

  // SKU
  sku             String      @unique      // "QNS-CLASSIC-PINK-M"

  // Quan hệ
  orderItems      OrderItem[]

  // Timestamps
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([productId, colorName, size])
  @@map("product_variants")
}

// ════════════════════════════════════════════
// MODEL: PRODUCT IMAGE
// ════════════════════════════════════════════
model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  url         String   // Cloudinary URL
  publicId    String   // Cloudinary public_id (để xóa)
  altText     String?
  colorName   String?  // null = dùng cho tất cả màu
  sortOrder   Int      @default(0)
  isMain      Boolean  @default(false)

  createdAt   DateTime @default(now())

  @@map("product_images")
}

// ════════════════════════════════════════════
// MODEL: CATEGORY
// ════════════════════════════════════════════
model Category {
  id          String            @id @default(cuid())
  slug        String            @unique
  name        String
  description String?
  sortOrder   Int               @default(0)

  products    CategoryProduct[]

  @@map("categories")
}

model CategoryProduct {
  productId   String
  categoryId  String
  product     Product   @relation(fields: [productId], references: [id])
  category    Category  @relation(fields: [categoryId], references: [id])

  @@id([productId, categoryId])
  @@map("category_products")
}

// ════════════════════════════════════════════
// MODEL: ORDER — Đơn hàng
// ════════════════════════════════════════════
model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique  // "QNS-483920-X7KP"

  // Khách hàng
  userId          String?       // null nếu guest checkout
  user            User?         @relation(fields: [userId], references: [id])
  guestEmail      String?       // Email guest (không có account)

  // Thông tin khách (snapshot — không phụ thuộc user profile)
  customerName    String
  customerEmail   String
  customerPhone   String

  // Địa chỉ giao hàng (snapshot)
  addressId       String?
  address         Address?      @relation(fields: [addressId], references: [id])
  shippingAddress Json          // { address, ward, district, city, fullAddress }

  // Sản phẩm
  items           OrderItem[]

  // Giá trị
  subtotal        Int           // Tổng trước giảm giá
  shippingFee     Int           @default(0)
  discount        Int           @default(0)
  total           Int           // Tổng cuối cùng

  // Voucher
  voucherId       String?
  voucher         Voucher?      @relation(fields: [voucherId], references: [id])
  voucherCode     String?

  // Trạng thái đơn hàng
  status          OrderStatus   @default(PENDING)

  // Thanh toán
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(UNPAID)
  paidAt          DateTime?
  paymentRef      String?       // Mã giao dịch VNPAY/MoMo

  // Vận chuyển
  shippingMethod  String        @default("standard")
  trackingNumber  String?
  shippedAt       DateTime?
  deliveredAt     DateTime?

  // Ghi chú
  customerNote    String?
  adminNote       String?       // Ghi chú nội bộ

  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("orders")
}

enum OrderStatus {
  PENDING           // Chờ xác nhận
  CONFIRMED         // Đã xác nhận
  PROCESSING        // Đang đóng gói
  SHIPPED           // Đã giao shipper
  DELIVERED         // Đã giao khách
  CANCELLED         // Đã hủy
  REFUNDED          // Đã hoàn tiền
}

enum PaymentMethod {
  COD
  VNPAY
  MOMO
  BANK_TRANSFER
}

enum PaymentStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  REFUNDED
  FAILED
}

// ════════════════════════════════════════════
// MODEL: ORDER ITEM — Chi tiết sản phẩm trong đơn
// ════════════════════════════════════════════
model OrderItem {
  id              String          @id @default(cuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id])

  productId       String
  product         Product         @relation(fields: [productId], references: [id])

  variantId       String
  variant         ProductVariant  @relation(fields: [variantId], references: [id])

  // Snapshot tại thời điểm đặt hàng
  productName     String
  colorName       String
  colorLabel      String
  size            String
  sku             String

  quantity        Int
  unitPrice       Int             // Giá tại thời điểm đặt
  totalPrice      Int             // unitPrice × quantity

  @@map("order_items")
}

// ════════════════════════════════════════════
// MODEL: VOUCHER — Mã giảm giá
// ════════════════════════════════════════════
model Voucher {
  id              String        @id @default(cuid())
  code            String        @unique  // "WELCOME10"
  description     String?

  // Loại giảm giá
  discountType    DiscountType  // PERCENTAGE hoặc FIXED
  discountValue   Int           // 10 (%) hoặc 50000 (đ)
  maxDiscount     Int?          // Giới hạn max giảm (với PERCENTAGE)
  minOrderValue   Int           @default(0)

  // Giới hạn sử dụng
  usageLimit      Int?          // null = không giới hạn
  usageCount      Int           @default(0)
  userUsageLimit  Int           @default(1) // Mỗi user dùng tối đa N lần

  // Thời hạn
  startsAt        DateTime?
  expiresAt       DateTime?
  isActive        Boolean       @default(true)

  orders          Order[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("vouchers")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

// ════════════════════════════════════════════
// MODEL: REVIEW — Đánh giá sản phẩm
// ════════════════════════════════════════════
model Review {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])

  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  guestName   String?  // Nếu không có account

  rating      Int      // 1–5
  title       String?
  content     String   @db.Text
  colorName   String?  // Đã mua màu nào
  size        String?  // Đã mua size nào

  isVerified  Boolean  @default(false)  // Đã mua thật
  isApproved  Boolean  @default(false)  // Admin duyệt
  isHidden    Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("reviews")
}

// ════════════════════════════════════════════
// MODEL: WISHLIST
// ════════════════════════════════════════════
model WishlistItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  colorName   String?

  createdAt   DateTime @default(now())

  @@unique([userId, productId, colorName])
  @@map("wishlist_items")
}

// ════════════════════════════════════════════
// MODEL: SESSION — Phiên đăng nhập
// ════════════════════════════════════════════
model Session {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  token       String   @unique
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@map("sessions")
}

// ════════════════════════════════════════════
// MODEL: INVENTORY LOG — Lịch sử kho
// ════════════════════════════════════════════
model InventoryLog {
  id          String      @id @default(cuid())
  variantId   String
  action      String      // "SALE", "RESTOCK", "ADJUST", "RESERVE", "RELEASE"
  quantity    Int         // Dương = nhập, Âm = xuất
  previousQty Int
  newQty      Int
  note        String?
  orderId     String?

  createdAt   DateTime    @default(now())

  @@map("inventory_logs")
}

// ════════════════════════════════════════════
// MODEL: NOTIFICATION LOG — Lịch sử thông báo
// ════════════════════════════════════════════
model NotificationLog {
  id          String   @id @default(cuid())
  type        String   // "ORDER_CONFIRM", "SHEET_WRITE", "PAYMENT_CONFIRM"
  recipient   String   // email address
  subject     String
  status      String   // "SENT", "FAILED"
  orderId     String?
  error       String?

  sentAt      DateTime @default(now())

  @@map("notification_logs")
}

// ════════════════════════════════════════════
// MODEL: ADMIN SETTING — Cấu hình hệ thống
// ════════════════════════════════════════════
model Setting {
  key         String   @id
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  @@map("settings")
}
