# ==============================================================================
# QUANNGUYENS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# ── SERVER CONFIG ─────────────────────────────────────
PORT=3001
NODE_ENV=production
ALLOWED_ORIGINS="https://quannguyens.com,https://www.quannguyens.com,http://localhost:3000,http://localhost:5173"

# ── ADMIN GATE & SESSION SECURITY ─────────────────────
# Mật khẩu quản trị truy cập trang /admin/orders và /admin/broadcast
ADMIN_PASSWORD="[mat-khau-quan-tri-manh-cua-ban]"
# Secret ký session token HMAC-SHA256 (bắt buộc trong production)
ADMIN_SESSION_SECRET="[random-64-char-hex-or-base64-string]"
ORDER_TOKEN_SECRET="[random-64-char-hex-or-base64-string]"

# ── BANK & VIETQR PAYMENT CONFIG ──────────────────────
BANK_CODE="VCB"
BANK_ACCOUNT_NUMBER="1050773506"
BANK_ACCOUNT_NAME="NGUYEN DUC QUAN"

# ── WEBHOOK SECURITY ──────────────────────────────────
# Secret đối soát webhook biến động số dư từ SePay / Bank
SEPAY_WEBHOOK_API_KEY="[your-sepay-api-key]"
PAYMENT_WEBHOOK_SECRET="[your-payment-webhook-secret]"

# ── GMAIL SMTP NOTIFICATION ───────────────────────────
# Đăng nhập Google Account > Bảo mật > Bật 2FA > Tạo Mật khẩu ứng dụng 16 ký tự
GMAIL_USER="quannguyens403@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
OWNER_EMAIL="quannguyens403@gmail.com"

# ── GOOGLE SHEETS ORDER STORAGE ───────────────────────
# Google Cloud Console > IAM & Admin > Service Accounts > Tạo key JSON
GOOGLE_SHEET_ID="[id-bang-tinh-google-sheets]"
GOOGLE_SERVICE_ACCOUNT_EMAIL="xxx@xxx.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"


# ── SHOP INFO ─────────────────────────────────────────
SHOP_NAME="QuanNguyenS"
SHOP_PHONE="0981753082"
SHOP_ADDRESS="Amber Riverside, 622 Minh Khai, Vĩnh Tuy, Hà Nội"
SHOP_SLOGAN="Dressed for Life. Even at Home."

# ── CLOUDFLARE TUNNEL & DOMAIN (CHẠY TÊN MIỀN KHÔNG CẦN VPS) ───
CLOUDFLARE_ACCOUNT_ID="[id-tai-khoan-cloudflare-cua-ban]"
CLOUDFLARE_ZONE_ID="[zone-id-domain-quannguyens-com]"
CLOUDFLARE_TUNNEL_TOKEN="[token-tunnel-lay-tu-cloudflare-zero-trust]"

# ── 12. CHATBOT TRỢ LÝ ẢO 24/7 (CHI PHÍ 0Đ / FREE TIER) ─────────────
CHAT_ENABLED=true
CHAT_PROVIDER="gemini"
CHAT_FALLBACK_PROVIDER="groq"

# API Keys (Lấy miễn phí, tuyệt đối không cần gắn thẻ ngân hàng)
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# Hạn mức nội bộ bảo vệ chống lạm dụng & cạn kiệt Quota
CHAT_DAILY_REQUEST_CAP=1200
CHAT_PER_IP_PER_MIN=10
CHAT_PER_SESSION_MAX_TURNS=20
CHAT_MAX_INPUT_CHARS=600
CHAT_MAX_OUTPUT_TOKENS=350
CHAT_HISTORY_TURNS=6
CHAT_STORE_TRANSCRIPTS=false

# Thông báo tức thì qua Telegram cho chủ shop khi khách yêu cầu Handoff (Tùy chọn)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_OWNER_CHAT_ID=""
