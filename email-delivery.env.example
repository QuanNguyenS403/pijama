# ═══════════════════════════════════════════════════════════════════════════
# CẤU HÌNH HỆ THỐNG GỬI EMAIL GIAO DỊCH (TRANSACTIONAL EMAIL & OTP DELIVERY)
# QuanNguyenS Sleepwear — Production Environment Template
# ═══════════════════════════════════════════════════════════════════════════

# 1. GMAIL SMTP (CHỈ DÙNG TRÊN LOCAL / VPS HOẶC RENDER GÓI TRẢ PHÍ)
# LƯU Ý QUAN TRỌNG: Render gói Free chặn cổng SMTP 25/465/587 từ 26/09/2025.
# Trên Render Free, hệ thống sẽ tự động bỏ qua SMTP để tránh treo 10-15s mỗi lần gửi.
# Nếu đã nâng cấp Render lên gói trả phí (Starter+), đặt EMAIL_ALLOW_SMTP_ON_RENDER=true.
# ⛔ CHỈ ĐẶT MẬT KHẨU ỨNG DỤNG TRÊN RENDER DASHBOARD HOẶC .env.local — KHÔNG GHI VÀO REPO!
GMAIL_USER=quannguyens403@gmail.com
GMAIL_APP_PASSWORD=
EMAIL_ALLOW_SMTP_ON_RENDER=false
OWNER_EMAIL=quannguyens403@gmail.com
EMAIL_REAL_SEND=true

# 2. CẦU GOOGLE APPS SCRIPT HTTPS (KHUYÊN DÙNG TRÊN RENDER GÓI FREE — QUA CỔNG 443)
GAS_EMAIL_WEBHOOK_URL=
GAS_WEBHOOK_SECRET=

# 3. RESEND API (TÙY CHỌN — CHỈ DÙNG KHI TÊN MIỀN ĐÃ XÁC MINH SPF/DKIM VÀ CÓ BẢN GHI MX NHẬN THƯ)
# Khóa API Resend (bắt đầu bằng re_)
RESEND_API_KEY=

# Email người gửi Resend (Chỉ đặt khi tên miền đã cấu hình MX và nhận được thư thật; không đặt địa chỉ thuộc tên miền chưa nhận thư)
RESEND_FROM_EMAIL=

# 3. KIỂM SOÁT HẠN MỨC & CHỐNG LẠM DỤNG (RATE LIMITING & QUOTA PROTECTION)
# Giới hạn số lượng email OTP tối đa toàn hệ thống mỗi giờ (Bảo vệ hạn mức 100 thư/ngày của Gmail)
OTP_EMAIL_MAX_PER_HOUR_GLOBAL=50

# Số hop proxy tin cậy của hạ tầng hosting (Render mặc định 1 hop phía sau Cloudflare/Envoy proxy)
TRUST_PROXY_HOPS=1

# 4. CÔNG TẮC BẢO TRÌ & THỬ NGHIỆM
# Đặt true để tắt hoàn toàn việc gửi email thật (máy chủ sẽ ghi log giả lập sandbox)
EMAIL_DELIVERY_DISABLED=false

