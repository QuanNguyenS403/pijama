# ═══════════════════════════════════════════════════════════════════════════
# CẤU HÌNH HỆ THỐNG GỬI EMAIL GIAO DỊCH (TRANSACTIONAL EMAIL & OTP DELIVERY)
# QuanNguyenS Sleepwear — Production Environment Template
# ═══════════════════════════════════════════════════════════════════════════

# 1. GOOGLE APPS SCRIPT HTTPS BRIDGE (ƯU TIÊN 1 — GỬI TỪ quannguyens403@gmail.com)
# URL Web App mới sau khi deploy lại Code.gs (Bản triển khai mới - New Deployment)
GAS_EMAIL_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbxsGaymlrhGlmUdlV49ma1bnYr42Fle3UP-KvPdhLIFBZLQH0Q9JpXfCUaqOvAbkUg5/exec

# Khóa bí mật xác thực webhook (Phải khớp với Script Property QNS_SEND_SECRET trên Apps Script)
GAS_WEBHOOK_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_SECRET

# Thời gian chờ tối đa khi gọi Apps Script (mili-giây, đề xuất 25000 cho Render Free cold start)
EMAIL_GAS_TIMEOUT_MS=25000

# 2. RESEND API DỰ PHÒNG (ƯU TIÊN 2 — CHỈ DÙNG VỚI TÊN MIỀN ĐÃ XÁC MINH SPF/DKIM)
# Khóa API Resend (bắt đầu bằng re_)
RESEND_API_KEY=re_CHANGE_ME_RESEND_API_KEY

# Email người gửi Resend (Bắt buộc phải thuộc tên miền riêng đã verify DNS, ví dụ quannguyens.com)
# CẢNH BÁO: Không sử dụng địa chỉ @resend.dev ở production vì chỉ gửi được tới chủ tài khoản Resend.
RESEND_FROM_EMAIL=QuanNguyenS <support@quannguyens.com>

# 3. KIỂM SOÁT HẠN MỨC & CHỐNG LẠM DỤNG (RATE LIMITING & QUOTA PROTECTION)
# Giới hạn số lượng email OTP tối đa toàn hệ thống mỗi giờ (Bảo vệ hạn mức 100 thư/ngày của Gmail)
OTP_EMAIL_MAX_PER_HOUR_GLOBAL=50

# Số hop proxy tin cậy của hạ tầng hosting (Render mặc định 1 hop phía sau Cloudflare/Envoy proxy)
TRUST_PROXY_HOPS=1

# 4. CÔNG TẮC BẢO TRÌ & THỬ NGHIỆM
# Đặt true để tắt hoàn toàn việc gửi email thật (máy chủ sẽ ghi log giả lập sandbox)
EMAIL_DELIVERY_DISABLED=false

