# ==============================================================================
# CHƯƠNG TRÌNH HỘI VIÊN & ĐẶC QUYỀN (LOYALTY SYSTEM) - BIẾN MÔI TRƯỜNG
# ==============================================================================
# Lưu ý: File này là tài liệu tham khảo cho hệ thống Loyalty.
# KHÔNG sửa file .env.example (file được bảo vệ theo PROTECTED-DATA.md).

# 1. CỜ BẬT/TẮT CHƯƠNG TRÌNH
# Mặc định là 'false'. Chỉ bật 'true' khi đã hoàn thành thử nghiệm và được chủ shop duyệt kinh tế.
LOYALTY_ENABLED=false

# 2. CẤU HÌNH NHÀ CUNG CẤP OTP SỐ ĐIỆN THOẠI (OTP PROVIDER)
# Tùy chọn: 'test' / 'mock' (chỉ dùng cho môi trường test/dev, BỊ CẤM ở production), 'zalo' (ZNS chính thức)
LOYALTY_OTP_PROVIDER=test
# Tương thích ngược: LOYALTY_PHONE_VERIFIER=test

# 3. CẤU HÌNH ZALO ZNS (Khi sử dụng nhà cung cấp Zalo ZNS chính thức)
# Hệ thống chấp nhận cả 2 cặp tên biến sau:
# ZALO_OA_ACCESS_TOKEN=your_zalo_oa_access_token_here (hoặc ZALO_OA_TOKEN)
# ZALO_ZNS_TEMPLATE_OTP=your_template_id_here (hoặc ZALO_OTP_TEMPLATE_ID)
# ZALO_APP_ID=your_zalo_app_id_here
# ZALO_SECRET_KEY=your_zalo_app_secret_here

# 4. CHỐNG LẠM DỤNG & GIỚI HẠN OTP (RATE LIMITING & BUDGET)
# Số lượt gửi OTP tối đa cho 1 số điện thoại trong 24h (mặc định: 5)
LOYALTY_OTP_DAILY_LIMIT_PER_PHONE=5
# Số lượt gửi OTP tối đa từ 1 địa chỉ IP trong 24h (mặc định: 20)
LOYALTY_OTP_DAILY_LIMIT_PER_IP=20
# Ngân sách gửi OTP toàn hệ thống tối đa trong 24h (mặc định: 200, chạm trần sẽ báo động và tạm dừng)
LOYALTY_OTP_DAILY_BUDGET_COUNT=200
# Thời gian chờ giữa 2 lần gửi mã OTP liên tiếp (giây, mặc định: 60)
LOYALTY_OTP_RESEND_COOLDOWN_SEC=60
# Thời gian hiệu lực của mã OTP (giây, mặc định: 300 = 5 phút)
LOYALTY_OTP_TTL_SEC=300
