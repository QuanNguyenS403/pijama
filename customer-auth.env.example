# =================================================================
# CẤU HÌNH HỆ THỐNG TÀI KHOẢN KHÁCH HÀNG & BẢO MẬT (QuanNguyenS)
# Tham khảo tài liệu thiết lập chi tiết tại: docs/customer-auth-setup.md
# Lưu ý: Không ghi đè hoặc sửa file .env.example (thuộc diện bảo vệ).
# =================================================================

# ── Cấu Hình URL & Domain ──
APP_URL=http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://quannguyens.vn

# ── Google Identity Services (Google OAuth 2.0) ──
# Lấy từ Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Meta / Facebook Login ──
# Lấy từ Meta Developers -> App Dashboard -> Settings -> Basic
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret


# ── Khóa Ký Token Phiên & Hủy Đăng Ký Marketing (HMAC) ──
# Khóa bí mật tối thiểu 32 ký tự ngẫu nhiên dùng ký token unsubscribe và CSRF
CUSTOMER_AUTH_SECRET=your_random_32_bytes_customer_auth_secret_here

# ── Chế độ Kiểm Thử Tự Động (Chỉ bật khi chạy Test Suite) ──
# AUTH_TEST_MODE=false
